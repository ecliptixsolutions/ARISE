# Arise Healthcare Solutions — Cloudflare Worker environment variables
# Copy this file to .env and fill in values. NEVER commit .env.

# ── Render API (Node.js backend) ─────────────────────────────
# Full HTTPS URL of the deployed Render Node.js API service (arise-api)
# Get this from: Render dashboard → arise-api → Settings → URL
# Example: https://arise-api-xxxx.onrender.com
HOSTINGER_API_URL=https://arise-api-xxxx.onrender.com

# Shared secret between Cloudflare Worker and Render API
# MUST match ARISE_API_SECRET configured in Render environment variables
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ARISE_API_SECRET=

# JWT session signing secret (must match SESSION_SECRET in Render environment variables)
SESSION_SECRET=

# ── Client-side (VITE_*) — exposed at build time ──────────────
# The Render API URL baked into the browser bundle at build time (URL only — no secret)
# Must match the value of HOSTINGER_API_URL above
VITE_HOSTINGER_API_URL=https://arise-api-xxxx.onrender.com

# ── Meta Pixel / CAPI ─────────────────────────────────────────
META_PIXEL_ID=2627672500983550
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# ── Removed Supabase variables ─────────────────────────────────
# VITE_SUPABASE_URL         — no longer used
# VITE_SUPABASE_PUBLISHABLE_KEY — no longer used
# SUPABASE_URL              — no longer used
# SUPABASE_PUBLISHABLE_KEY  — no longer used
# SUPABASE_SERVICE_ROLE_KEY — no longer used
# VITE_TURNSTILE_SITE_KEY   — removed (Turnstile was optional; can be re-added if needed)
