# Arise Healthcare Solutions — Cloudflare Worker environment variables
# Copy this file to .env and fill in values. NEVER commit .env.

# ── Hostinger API bridge ──────────────────────────────────────
# Full HTTPS URL of the deployed Hostinger Node.js API
HOSTINGER_API_URL=https://api.arisehealthcare.in

# Shared secret between Cloudflare Worker and Hostinger API
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ARISE_API_SECRET=

# JWT session signing secret (must match hostinger-api SESSION_SECRET)
SESSION_SECRET=

# ── Client-side (VITE_*) — exposed at build time ──────────────
# The API URL that the browser JS uses to call the Hostinger API
VITE_HOSTINGER_API_URL=https://api.arisehealthcare.in

# ── Meta Pixel / CAPI ─────────────────────────────────────────
META_PIXEL_ID=2627672500983550
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# ── Removed Supabase variables ─────────────────────────────────
# VITE_SUPABASE_URL         — no longer used
# VITE_SUPABASE_PUBLISHABLE_KEY — no longer used
# SUPABASE_URL              — no longer used
# SUPABASE_PUBLISHABLE_KEY  — no longer used
# SUPABASE_SERVICE_ROLE_KEY — no longer used
# VITE_TURNSTILE_SITE_KEY   — removed (Turnstile was optional; can be re-added if needed)
