# ============================================================
# Arise Healthcare Solutions — Hostinger API environment variables
# Deploy this file to the Hostinger server.
# Copy to .env and fill in ALL values. NEVER commit .env.
# ============================================================

# ── MySQL ────────────────────────────────────────────────────
# Keep real DB credentials only in hostinger-api/.env or deployment env vars.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# ── Server-to-server authentication ──────────────────────────
# Shared secret between Cloudflare Worker and this API.
# Cloudflare Worker sends this in x-arise-secret header.
# NEVER expose in browser code or VITE_ variables.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ARISE_API_SECRET=

# ── JWT session signing secret ────────────────────────────────
# Used to sign/verify user session tokens.
# Must match SESSION_SECRET set on Cloudflare Worker.
# NEVER expose in browser code or VITE_ variables.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ── Server port ───────────────────────────────────────────────
PORT=3001

# ── CORS allowed origins ──────────────────────────────────────
# Comma-separated list of allowed browser origins.
# Example: https://arisehealthcaresolutions.com,https://www.arisehealthcaresolutions.com
ALLOWED_ORIGIN=http://localhost:5173

# ── Node environment ──────────────────────────────────────────
NODE_ENV=production

# ── Resend email (login alerts + password reset) ─────────────
# Optional: if empty, login alert emails are silently skipped.
RESEND_API_KEY=
SECURITY_ALERT_FROM_EMAIL=
RESEND_FROM_EMAIL=

# ── Data migration only (used by data-migration.js) ──────────
# ONLY add this on the Hostinger server for the migration run.
# Remove it from .env after migration is complete.
# NEVER expose to browser, Cloudflare, or source control.
# SUPABASE_URL=https://thcpriduqrznrwqsuocq.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<your Supabase service-role key>
